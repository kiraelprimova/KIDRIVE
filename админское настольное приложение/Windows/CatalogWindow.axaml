<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestDriveAvalonia.Windows.CatalogWindow"
        Title="Каталог автомобилей"
        WindowState="Maximized"
        Background="#F5F5F5"
        Icon="/Resources/logo.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="15,20,15,0">
                    <TextBlock Text="Автосалон"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Тест-драйв"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,25,10,0">
                    <Button x:Name="CatalogButton"
                            Height="38"
                            Margin="0,0,0,12"
                            Background="#1E3A8A"
                            Foreground="White"
                            CornerRadius="8"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚘" FontSize="14" Margin="12,0,10,0"/>
                            <TextBlock Text="Каталог автомобилей" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BookingsButton"
                            Height="38"
                            Margin="0,0,0,12"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Click="BookingsButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="13" Margin="12,0,10,0"/>
                            <TextBlock Text="Мои бронирования" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ProfileButton"
                            Height="38"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Click="ProfileButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="13" Margin="12,0,10,0"/>
                            <TextBlock Text="Профиль" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1" RowDefinitions="55,*">
            <!-- Верхняя плашка -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid Margin="15,0" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                        <TextBlock x:Name="UserEmailText"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ExitButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↪" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0"/>
                            <TextBlock Text="Выйти" FontSize="13" Foreground="#6B7280"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Контент каталога -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Каталог автомобилей"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <!-- Поисковая строка -->
                            <Border Background="#F9FAFB"
                                    BorderBrush="#1E3A8A"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Height="44">
                                <Grid ColumnDefinitions="45,*">
                                    <TextBlock Text="🔍"
                                               FontSize="14"
                                               Foreground="#1E3A8A"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <TextBox x:Name="SearchBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             Foreground="#111827"
                                             VerticalContentAlignment="Center"
                                             Watermark="Поиск по названию или марке..."/>
                                </Grid>
                            </Border>

                            <!-- Фильтры -->
                            <Grid Margin="0,15,0,0" ColumnDefinitions="*,20,*,20,*">
                                <StackPanel>
                                    <TextBlock Text="Марка" FontSize="12" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="BrandBox" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Год выпуска" FontSize="12" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="YearBox" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Сортировка" FontSize="12" Margin="2,0,0,6"/>
                                    <ComboBox x:Name="SortBox" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Все"/>
                                        <ComboBoxItem Content="А-Я"/>
                                        <ComboBoxItem Content="Я-А"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Список машин -->
                    <WrapPanel x:Name="CarsPanel"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <TextBlock x:Name="EmptyText"
                               Text="Здесь пока ничего нет"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               IsVisible="False"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
