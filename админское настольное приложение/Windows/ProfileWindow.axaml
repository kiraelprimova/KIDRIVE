<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestDriveAvalonia.Windows.ProfileWindow"
        Title="Профиль"
        WindowState="Maximized"
        Background="#F5F5F5"
        Icon="/Resources/logo.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Меню слева -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="15,20,15,0">
                    <TextBlock Text="Автосалон"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Тест-драйв"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,25,10,0">
                    <Button Height="38"
                            Margin="0,0,0,12"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Click="CatalogButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚘" FontSize="14" Margin="12,0,10,0"/>
                            <TextBlock Text="Каталог автомобилей" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Margin="0,0,0,12"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Click="BookingsButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="13" Margin="12,0,10,0"/>
                            <TextBlock Text="Мои бронирования" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="13" Margin="12,0,10,0"/>
                            <TextBlock Text="Профиль" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <Grid Grid.Column="1" RowDefinitions="55,*">
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid Margin="15,0" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                        <TextBlock x:Name="UserEmailText"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ExitButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↪" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0"/>
                            <TextBlock Text="Выйти" FontSize="13" Foreground="#6B7280"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="32">
                    <Border Background="White"
                            CornerRadius="14"
                            Padding="32,36"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            BoxShadow="0 4 16 0 #0D000000"
                            MaxWidth="900"
                            HorizontalAlignment="Stretch">

                        <StackPanel>
                            <!-- Заголовок карточки и действия в стиле веб-клиента -->
                            <DockPanel Margin="0,0,0,28">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Профиль"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#111827"/>
                                    <TextBlock Text="Управляйте личными данными вашего аккаунта"
                                               FontSize="13.5"
                                               Foreground="#6B7280"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ChangePasswordButton"
                                            Height="38"
                                            Padding="16,0"
                                            Margin="0,0,10,0"
                                            Background="#EFF6FF"
                                            Foreground="#1E3A8A"
                                            BorderBrush="#BFDBFE"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Cursor="Hand"
                                            Click="ChangePasswordButton_Click">
                                        <TextBlock Text="Изменить пароль" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Button>

                                    <Button x:Name="SaveButton"
                                            Height="38"
                                            Padding="18,0"
                                            Margin="0,0,10,0"
                                            Background="#1E3A8A"
                                            Foreground="White"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            Cursor="Hand"
                                            Click="SaveButton_Click">
                                        <TextBlock Text="Сохранить изменения" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Button>

                                    <Button x:Name="DeleteButton"
                                            Height="38"
                                            Padding="14,0"
                                            Background="Transparent"
                                            Foreground="#DC2626"
                                            BorderBrush="#FECACA"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Cursor="Hand"
                                            Click="DeleteButton_Click">
                                        <TextBlock Text="Удалить аккаунт" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- Разделитель -->
                            <Border Height="1" Background="#F3F4F6" Margin="0,0,0,24"/>

                            <!-- Поля профиля: сетка в 2 колонки как в клиенте -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                <!-- Колонка 1, Строка 0: Имя -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,18">
                                    <TextBlock Text="Имя *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                                    <TextBox x:Name="FirstNameBox" Height="42" FontSize="14" Watermark="Ваше имя" MaxLength="20"/>
                                </StackPanel>

                                <!-- Колонка 2, Строка 0: Фамилия -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,18">
                                    <TextBlock Text="Фамилия *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                                    <TextBox x:Name="LastNameBox" Height="42" FontSize="14" Watermark="Ваша фамилия" MaxLength="25"/>
                                </StackPanel>

                                <!-- Колонка 1, Строка 1: Отчество -->
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,18">
                                    <TextBlock Text="Отчество" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                                    <TextBox x:Name="PatronymicBox" Height="42" FontSize="14" Watermark="Ваше отчество (если есть)" MaxLength="25"/>
                                </StackPanel>

                                <!-- Колонка 2, Строка 1: Телефон -->
                                <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,0,0,18">
                                    <TextBlock Text="Номер телефона *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                                    <TextBox x:Name="PhoneBox" Height="42" FontSize="14" Watermark="+7 (___) ___-__-__" MaxLength="20"/>
                                    <TextBlock Text="Проверяется на уникальность среди аккаунтов" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Колонка 1, Строка 2: Электронная почта -->
                                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,12,0">
                                    <TextBlock Text="Электронная почта *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                                    <TextBox x:Name="EmailBox" Height="42" FontSize="14" Watermark="example@mail.ru" MaxLength="40"/>
                                    <TextBlock Text="Проверяется на уникальность среди аккаунтов" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Колонка 2, Строка 2: Дата рождения -->
                                <StackPanel Grid.Column="1" Grid.Row="2" Margin="12,0,0,0">
                                    <TextBlock Text="Дата рождения *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="BirthDateBox" Height="42" FontSize="13"/>
                                    <TextBlock Text="Доступно только лицам старше 18 лет" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
