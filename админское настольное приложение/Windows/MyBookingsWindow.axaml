<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestDriveAvalonia.Windows.MyBookingsWindow"
        Title="Мои бронирования"
        WindowState="Maximized"
        Background="#F5F5F5"
        Icon="/Resources/logo.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="15,20,15,0">
                    <TextBlock Text="Автосалон"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Тест-драйв"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,25,10,0">
                    <Button Height="38"
                            Margin="0,0,0,12"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Click="CatalogButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚘" FontSize="14" Margin="12,0,10,0"/>
                            <TextBlock Text="Каталог автомобилей" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Margin="0,0,0,12"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="13" Margin="12,0,10,0"/>
                            <TextBlock Text="Мои бронирования" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="38"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Click="ProfileButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="13" Margin="12,0,10,0"/>
                            <TextBlock Text="Профиль" FontSize="13" Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1" RowDefinitions="55,*">
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid Margin="15,0" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                        <TextBlock x:Name="UserEmailText"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ExitButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↪" FontSize="13" Foreground="#6B7280" Margin="0,0,6,0"/>
                            <TextBlock Text="Выйти" FontSize="13" Foreground="#6B7280"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25">
                    <TextBlock Text="Мои бронирования"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

                    <ComboBox x:Name="StatusFilterBox"
                              Width="220"
                              Height="38"
                              Margin="0,0,0,20">
                        <ComboBoxItem Content="Все"/>
                        <ComboBoxItem Content="В рассмотрении"/>
                        <ComboBoxItem Content="Подтверждено"/>
                        <ComboBoxItem Content="Завершено"/>
                        <ComboBoxItem Content="Отменено"/>
                    </ComboBox>

                    <StackPanel x:Name="BookingsPanel"/>

                    <TextBlock x:Name="EmptyBookingsText"
                               Text="Здесь пока пусто, перейдите в каталог, чтобы забронировать автомобиль"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,80,0,0"
                               IsVisible="False"
                               MaxWidth="500"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
