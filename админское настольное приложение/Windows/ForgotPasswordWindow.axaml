<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestDriveAvalonia.Windows.ForgotPasswordWindow"
        Title="Восстановление пароля"
        Width="420"
        Height="650"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Icon="/Resources/logo.ico">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="35">

            <TextBlock Text="Восстановление пароля"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#3D3D3D"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Номер телефона"
                       FontSize="13"
                       Foreground="#666666"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="PhoneBox"
                     Height="35"
                     FontSize="13"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#D0D0D0"
                     BorderThickness="1"
                     CornerRadius="6"
                     Margin="0,0,0,20"
                     MaxLength="18"/>

            <Button x:Name="SendCodeButton"
                    Content="Отправить код"
                    Height="42"
                    Background="#1E3A8A"
                    Foreground="White"
                    FontSize="14"
                    CornerRadius="6"
                    Cursor="Hand"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0,0,0,20"
                    Click="SendCodeButton_Click"/>

            <StackPanel x:Name="CodePanel"
                        IsVisible="False">

                <TextBlock Text="Введите код"
                           FontSize="13"
                           Foreground="#666666"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="CodeBox"
                         Height="35"
                         FontSize="13"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#D0D0D0"
                         BorderThickness="1"
                         CornerRadius="6"
                         Margin="0,0,0,20"/>

                <Button Content="Подтвердить"
                        Height="42"
                        Background="#1E3A8A"
                        Foreground="White"
                        FontSize="14"
                        CornerRadius="6"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,0,20"
                        Click="ConfirmCodeButton_Click"/>

            </StackPanel>

            <StackPanel x:Name="PasswordPanel"
                        IsVisible="False">

                <TextBlock Text="Новый пароль"
                           FontSize="13"
                           Foreground="#666666"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,5">
                    <TextBox x:Name="Password"
                             Height="35"
                             FontSize="13"
                             Padding="10,0,40,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#D0D0D0"
                             BorderThickness="1"
                             CornerRadius="6"
                             PasswordChar="•"/>

                    <CheckBox x:Name="ShowPassword"
                              Content="👁"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Background="Transparent"
                              BorderThickness="0"/>
                </Grid>

                <TextBlock Text="Минимум 8 символов"
                           FontSize="11"
                           Foreground="#999999"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Подтверждение пароля"
                           FontSize="13"
                           Foreground="#666666"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,20">
                    <TextBox x:Name="ConfirmPassword"
                             Height="35"
                             FontSize="13"
                             Padding="10,0,40,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#D0D0D0"
                             BorderThickness="1"
                             CornerRadius="6"
                             PasswordChar="•"/>

                    <CheckBox x:Name="ShowConfirmPassword"
                              Content="👁"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Background="Transparent"
                              BorderThickness="0"/>
                </Grid>

                <Button Content="Изменить пароль"
                        Height="42"
                        Background="#1E3A8A"
                        Foreground="White"
                        FontSize="14"
                        CornerRadius="6"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="ChangePasswordButton_Click"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
