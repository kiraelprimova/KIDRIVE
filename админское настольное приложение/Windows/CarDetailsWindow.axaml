<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestDriveAvalonia.Windows.CarDetailsWindow"
        Title="Информация об автомобиле"
        Width="1030"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        CanResize="False"
        Icon="/Resources/logo.ico">

    <Grid Margin="25">
        <Border Background="White"
                CornerRadius="20"
                BoxShadow="0 2 12 0 #14000000">

            <Grid Margin="28" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Width="110"
                            Height="42"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            CornerRadius="10"
                            Cursor="Hand"
                            Foreground="White"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="BackButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="←" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Назад" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="Информация об автомобиле"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#111827"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,25,0,0" ColumnDefinitions="1.2*,35,1*">
                    <Border Grid.Column="0"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">
                        <Image x:Name="CarImage"
                               Stretch="Uniform"
                               Margin="25"/>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Автомобиль"
                                       FontSize="13"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="BrandText"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,20"/>

                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Год выпуска"
                                               FontSize="12"
                                               Foreground="#6B7280"/>
                                    <TextBlock x:Name="YearText"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="#1E3A8A"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F9FAFB"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Описание"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="DescriptionText"
                                               FontSize="14"
                                               Foreground="#374151"
                                               TextWrapping="Wrap"
                                               LineHeight="24"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
