<UserControl x:Class="TestDrive.UserControls.CarCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="471"
             Width="301">

    <Border Background="White"
            CornerRadius="15"
            Margin="10">

        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              ShadowDepth="3"
                              Opacity="0.2"/>
        </Border.Effect>

        <StackPanel>

            <Border Height="236"
                    CornerRadius="15,15,0,0"
                    Background="#F3F4F6"
                    ClipToBounds="True"
                    Margin="0,10,0,0">

                <Image x:Name="CarImage"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            </Border>

            <StackPanel Margin="15">

                <TextBlock x:Name="BrandText"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock x:Name="YearText"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>

                <TextBlock x:Name="PriceText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1E3A8A"
                           Margin="0,8,0,0"/>

                <TextBlock x:Name="DescriptionText"
                           FontSize="13"
                           Foreground="#4B5563"
                           TextWrapping="Wrap"
                           TextTrimming="WordEllipsis"
                           MaxHeight="38"
                           Margin="0,10,0,15"/>

                <StackPanel Orientation="Horizontal">

                    <Button x:Name="MoreButton"
                            Content="Подробнее"
                            Height="40"
                            Width="116"
                            Background="#1E3A8A"
                            Foreground="White"
                            FontSize="14"
                            Cursor="Hand"
                            Click="MoreButton_Click">

                        <Button.Style>
                            <Style TargetType="Button">

                                <Setter Property="Template">
                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>
                                </Setter>

                            </Style>
                        </Button.Style>

                    </Button>

                    <Button x:Name="BronButton"
                            Content="Бронь"
                            Height="40"
                            Width="116"
                            Margin="14,0,0,0"
                            Background="#1E3A8A"
                            Foreground="White"
                            FontSize="14"
                            Cursor="Hand"
                            Click="BronButton_Click">

                        <Button.Style>
                            <Style TargetType="Button">

                                <Setter Property="Template">
                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>
                                </Setter>

                            </Style>
                        </Button.Style>

                    </Button>

                </StackPanel>

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>