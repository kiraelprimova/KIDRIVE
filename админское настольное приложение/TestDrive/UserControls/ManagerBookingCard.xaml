<UserControl x:Class="TestDrive.UserControls.ManagerBookingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="170"
             HorizontalAlignment="Stretch">

    <Border Background="White"
            CornerRadius="15"
            Margin="0,0,0,15"
            Padding="20">

        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              ShadowDepth="3"
                              Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть -->
            <StackPanel>

                <TextBlock x:Name="ClientText"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock x:Name="CarText"
                           FontSize="16"
                           Margin="0,12,0,0"
                           Foreground="#374151"/>

                <TextBlock x:Name="DateText"
                           FontSize="15"
                           Margin="0,8,0,0"
                           Foreground="#6B7280"/>

            </StackPanel>

            <!-- Правая часть (улучшенная) -->
            <Border Grid.Column="1"
                    Background="#F9FAFB"
                    CornerRadius="12"
                    Padding="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Right">

                    <!-- Статус -->
                    <Border x:Name="StatusBorder"
                            Height="30"
                            Padding="12,0"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10">

                        <TextBlock x:Name="StatusText"
           FontSize="13"
           FontWeight="SemiBold"
           Foreground="White"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"
           Text=""/>
                    </Border>

                    <!-- Кнопки -->
                    <StackPanel x:Name="ButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Width="100"
                                Height="36"
                                Background="#16A34A"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,8,0"
                                Click="ApproveButton_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <TextBlock Text="Принять"
                                       FontWeight="SemiBold"/>
                        </Button>

                        <Button Width="100"
                                Height="36"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="RejectButton_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <TextBlock Text="Отклонить"
                                       FontWeight="SemiBold"/>
                        </Button>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>
    </Border>
</UserControl>