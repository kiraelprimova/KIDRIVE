<Window x:Class="TestDrive.Windows.MyBookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои бронирования"
        WindowState="Maximized"
        Background="#F5F5F5"
        Icon="/Resources/logo.ico">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,20,10,0">

                    <TextBlock Text="Автосалон"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Тест-драйв"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="8,25,8,0">

                    <Button Height="34"
                            Margin="0,0,0,12"
                            Click="CatalogButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="🚘"
                                                   FontSize="14"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Каталог автомобилей"
                                   FontSize="13"
                                   Foreground="#111827"/>

                    </Button>

                    <Button Height="34"
                            Margin="0,0,0,12"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="📅"
                                                   FontSize="13"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Мои бронирования"
                                   FontSize="13"/>

                    </Button>

                    <Button Height="34"
                            Margin="0,0,0,12"
                            Click="ProfileButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="👤"
                                                   FontSize="13"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Профиль"
                                   FontSize="13"
                                   Foreground="#111827"/>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="UserNameText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="UserEmailText"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="90"
                            Height="30"
                            Click="ExitButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="↪"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="Выйти"
                                       FontSize="13"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1">

                <StackPanel Margin="20">

                    <TextBlock Text="Мои бронирования"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

                    <ComboBox x:Name="StatusFilterBox"
                              Width="220"
                              Height="38"
                              Margin="0,0,0,20"
                              SelectionChanged="StatusFilterBox_SelectionChanged">

                        <ComboBoxItem Content="Все"/>
                        <ComboBoxItem Content="В рассмотрении"/>
                        <ComboBoxItem Content="Подтверждено"/>
                        <ComboBoxItem Content="Отменено"/>

                    </ComboBox>

                    <StackPanel x:Name="BookingsPanel"/>

                    <TextBlock x:Name="EmptyBookingsText"
                               Text="Здесь пока пусто, перейдите в каталог, чтобы забронировать автомобиль"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,80,0,0"
                               Visibility="Collapsed"
                               MaxWidth="500"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>