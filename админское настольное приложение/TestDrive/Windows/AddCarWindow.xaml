<Window x:Class="TestDrive.Windows.AddCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить автомобиль"
        Height="799"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        Icon="/Resources/logo.ico">

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="15"
                Padding="25">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Добавить автомобиль"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Категория"/>

                    <ComboBox x:Name="CategoryBox"
                              Height="40"
                              Margin="0,5,0,15"
                              DisplayMemberPath="nameCategory"
                              SelectedValuePath="idCategory"/>

                    <TextBlock Text="Модель"/>

                    <TextBox x:Name="ModelBox"
                             Height="40"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Год"/>

                    <TextBox x:Name="YearBox"
                             Height="40"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Цена"/>

                    <TextBox x:Name="PriceBox"
                             Height="40"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Описание"/>

                    <TextBox x:Name="DescriptionBox"
                             Height="120"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Картинка"/>

                    <Grid Margin="0,5,0,30">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ImageBox"
             Height="40"
             IsReadOnly="True"
             VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
            Margin="10,0,10,0"
            Content="Выбрать"
            Background="#1E3A8A"
            Foreground="White"
            BorderThickness="0"
            Cursor="Hand"
            Click="SelectImageButton_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="10">

                                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </Grid>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Height="45"
                                Background="#1E3A8A"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="SaveButton_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <TextBlock Text="Сохранить"/>

                        </Button>

                        <Button Grid.Column="2"
                                Height="45"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CancelButton_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <TextBlock Text="Отмена"/>

                        </Button>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>