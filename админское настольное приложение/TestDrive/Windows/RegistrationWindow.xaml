 <Window x:Class="TestDrive.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="815"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
         Icon="/Resources/logo.ico">

    

        <StackPanel Margin="35">

            <TextBlock Text="Регистрация"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#FF3D3D3D"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <TextBlock Text="Имя *"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="FirstName"
                     Height="35"
                     FontSize="13"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#FFD0D0D0"
                     BorderThickness="1"
                     TextChanged="Capitalize_TextChanged"
                     Margin="0,0,0,12"
                     MaxLength="10"/>

            <TextBlock Text="Фамилия *"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="LastName"
                     Height="35"
                     FontSize="13"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#FFD0D0D0"
                     BorderThickness="1"
                     TextChanged="Capitalize_TextChanged"
                     Margin="0,0,0,12"
                     MaxLength="15"/>

            <TextBlock Text="Отчество"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"
                       />

            <TextBox x:Name="Patronymic"
                     Height="35"
                     FontSize="13"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#FFD0D0D0"
                     BorderThickness="1"
                     TextChanged="Capitalize_TextChanged"
                     Margin="0,0,0,12"
                     MaxLength="15"/>

            <TextBlock Text="Номер телефона *"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="PhoneNumber"
                     Height="35"
                     FontSize="13"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#FFD0D0D0"
                     BorderThickness="1"
                     Margin="0,0,0,12"
                     TextChanged="PhoneNumber_TextChanged"
                     MaxLength="18"/>

        

        <TextBox x:Name="Email"
         Visibility="Collapsed"
         Text="fatkhlislamovad@mail.ru"
                 MaxLength="30"/>

        <TextBlock Text="Пароль *"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"/>

            <Grid Margin="0,0,0,5">

                <PasswordBox x:Name="Password"
                             Height="35"
                             FontSize="13"
                             Padding="10,0,40,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#FFD0D0D0"
                             BorderThickness="1"
                             MaxLength="20"
                             PasswordChanged="Password_PasswordChanged"/>

                <TextBox x:Name="PasswordText"
                         Height="35"
                         FontSize="13"
                         Padding="10,0,40,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#FFD0D0D0"
                         BorderThickness="1"
                         Visibility="Collapsed"
                         MaxLength="20"
                         TextChanged="PasswordText_TextChanged"/>

                <CheckBox x:Name="ShowPassword"
                          Content="👁"
                          Width="40"
                          Height="20"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Checked="ShowPassword_Checked"
                          Unchecked="ShowPassword_Unchecked"/>

            </Grid>

            <TextBlock Text="Минимум 8 символов"
                       FontSize="11"
                       Foreground="#999"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Подтверждение пароля *"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"/>

            <Grid Margin="0,0,0,12">

                <PasswordBox x:Name="ConfirmPassword"
                             Height="35"
                             FontSize="13"
                             Padding="10,0,40,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#FFD0D0D0"
                             BorderThickness="1"
                             MaxLength="20"
                             PasswordChanged="ConfirmPassword_PasswordChanged"/>

                <TextBox x:Name="ConfirmPasswordText"
                         Height="35"
                         FontSize="13"
                         Padding="10,0,40,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#FFD0D0D0"
                         BorderThickness="1"
                         Visibility="Collapsed"
                         MaxLength="20"
                         TextChanged="ConfirmPasswordText_TextChanged"/>

                <CheckBox x:Name="ShowConfirmPassword"
                          Content="👁"
                          Width="40"
                          Height="20"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Checked="ShowConfirmPassword_Checked"
                          Unchecked="ShowConfirmPassword_Unchecked"/>

            </Grid>

            <TextBlock Text="Дата рождения *"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"/>

            <DatePicker x:Name="BirthDatePicker"
                        Height="35"
                        FontSize="13"
                        Margin="0,0,0,25"
                        SelectedDateFormat="Short"/>

            <Button x:Name="RegisterButton"
                    Content="Зарегистрироваться"
                    Width="180"
                    Height="42"
                    Background="#FF1E3A8A"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15"
                    Click="RegisterButton_Click">

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>

            </Button>

            <Button x:Name="AuthBT"
                    Content="Уже есть аккаунт? Войти"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FF028AB4"
                    FontSize="12"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Padding="0"
                    Click="AuthBT_Click">

                <Button.Style>
                    <Style TargetType="Button">

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextDecorations="Underline"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="#FF4F2826"/>
                            </Trigger>
                        </Style.Triggers>

                    </Style>
                </Button.Style>

            </Button>

        </StackPanel>

  

</Window>
