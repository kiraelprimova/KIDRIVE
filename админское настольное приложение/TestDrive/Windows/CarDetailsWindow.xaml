<Window x:Class="TestDrive.Windows.CarDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация об автомобиле"
        Height="760"
        Width="1030"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        ResizeMode="NoResize"
        Icon="/Resources/logo.ico">

    <Grid Margin="25">

        <Border Background="White"
                CornerRadius="20">

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.08"/>
            </Border.Effect>

            <Grid Margin="28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Width="110"
                            Height="42"
                            Click="BackButton_Click"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="White"
                            FontSize="14">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="←"
                                                   FontSize="15"
                                                   Margin="0,0,8,0"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Назад"/>

                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="Информация об автомобиле"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#111827"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>

                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,25,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">

                        <Image x:Name="CarImage"
                               Stretch="Uniform"
                               Margin="25"/>

                    </Border>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Автомобиль"
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="BrandText"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,20"/>

                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,18">

                            <StackPanel>

                                <TextBlock Text="Год выпуска"
                                           FontSize="12"
                                           Foreground="#6B7280"/>

                                <TextBlock x:Name="YearText"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#1E3A8A"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Background="#F9FAFB"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>

                                <TextBlock Text="Описание"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#6B7280"
                                           Margin="0,0,0,10"/>

                                <TextBlock x:Name="DescriptionText"
                                           FontSize="15"
                                           Foreground="#374151"
                                           TextWrapping="Wrap"
                                           LineHeight="26"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>