<Window x:Class="TestDrive.Windows.ManagerCarsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestDrive.UserControls"
        Title="Автомобили"
        WindowState="Maximized"
        Background="#F3F4F6"
        Icon="/Resources/logo.ico">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="15,20,15,0">

                    <TextBlock Text="Автосалон"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Панель менеджера"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="10,30,10,0">

                    <Button Height="40"
                            Background="#1E3A8A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🚘"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Автомобили"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Margin="0,10,0,0"
                            BorderThickness="0"
                            Background="White"
                            Cursor="Hand"
                            Click="BookingsButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📅"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Бронирования"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
        Margin="0,10,0,0"
        BorderThickness="0"
        Background="White"
        Cursor="Hand"
        Click="AnalyticsButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📊"
                   Margin="10,0,10,0"/>

                            <TextBlock Text="Аналитика"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Margin="0,10,0,0"
                            BorderThickness="0"
                            Background="White"
                            Cursor="Hand"
                            Click="ProfileButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="👤"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Профиль"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="UserText"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <TextBlock x:Name="EmailText"
                                   Foreground="#9CA3AF"
                                   FontSize="12"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="90"
                            Height="35"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="ExitButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="↪"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="Выйти"
                                       Margin="5,0,0,0"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="20">

                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Управление автомобилями"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Width="200"
                                Height="45"
                                Background="#1E3A8A"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AddButton_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="+"
                                           FontSize="18"
                                           Margin="0,0,10,0"/>

                                <TextBlock Text="Добавить автомобиль"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <Border Background="#F9FAFB"
                                    BorderBrush="#1E3A8A"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Height="46">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🔍"
                                               FontSize="14"
                                               Foreground="#1E3A8A"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <TextBox x:Name="SearchBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             TextChanged="SearchBox_TextChanged"/>

                                </Grid>

                            </Border>

                            <Grid Margin="0,15,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Марка"
                                               FontSize="12"
                                               Margin="2,0,0,6"/>

                                    <ComboBox x:Name="BrandBox"
                                              Height="27"
                                              Background="#F3F4F6"
                                              BorderBrush="#E5E7EB"
                                              SelectionChanged="BrandBox_SelectionChanged"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="Год выпуска"
                                               FontSize="12"
                                               Margin="2,0,0,6"/>

                                    <ComboBox x:Name="YearBox"
                                              Height="27"
                                              Background="#F3F4F6"
                                              BorderBrush="#E5E7EB"
                                              SelectionChanged="YearBox_SelectionChanged"/>

                                </StackPanel>

                                <StackPanel Grid.Column="4">

                                    <TextBlock Text="Сортировка"
                                               FontSize="12"
                                               Margin="2,0,0,6"/>

                                    <ComboBox x:Name="SortBox"
                                              Height="27"
                                              Background="#F3F4F6"
                                              BorderBrush="#E5E7EB"
                                              SelectionChanged="SortBox_SelectionChanged">

                                        <ComboBoxItem Content="Все"/>
                                        <ComboBoxItem Content="А-Я"/>
                                        <ComboBoxItem Content="Я-А"/>

                                    </ComboBox>

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <StackPanel x:Name="CarsPanel"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"/>

                    <TextBlock x:Name="EmptyText"
                               Text="Здесь пока ничего нет"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               Margin="0,60,0,0"
                               Visibility="Collapsed"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>