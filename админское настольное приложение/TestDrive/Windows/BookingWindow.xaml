 <Window x:Class="TestDrive.Windows.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Бронирование"
        Height="780"
        Width="1030"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        ResizeMode="NoResize"
        Icon="/Resources/logo.ico">

    <Grid Margin="25">

        <Border Background="White"
                CornerRadius="20">

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.08"/>
            </Border.Effect>

            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Width="110"
                            Height="40"
                            Click="BackButton_Click"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="←"
                                                   Margin="0,0,6,0"
                                                   FontSize="14"/>

                                        <ContentPresenter/>

                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Назад"/>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="Бронирование тест-драйва"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#111827"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>

                </Grid>

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="16"
                            Background="#F3F4F6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            ClipToBounds="True">

                        <Image x:Name="CarImage"
                               Stretch="Uniform"
                               Margin="20"/>
                    </Border>

                    <StackPanel Grid.Column="2">

                        <TextBlock x:Name="CarText"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,15"/>

                        <TextBlock x:Name="PriceText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E3A8A"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Дата"
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <DatePicker x:Name="BookingDate"
                                    Height="40"
                                    Margin="0,5,0,15"
                                    SelectedDateFormat="Short"
                                    DisplayDateStart="{x:Static sys:DateTime.Today}"/>

                        <TextBlock Text="Время"
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <ComboBox x:Name="TimeBox"
                          Height="40"
                          Margin="0,5,0,15"
                          DisplayMemberPath="TimeString">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="Gray"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <TextBlock Text="Способ оплаты"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,5,0,5"/>

                        <StackPanel Margin="0,5,0,10">

                            <RadioButton x:Name="CashCheck"
                                    Content="Наличный расчет"
                                    GroupName="PaymentMethod"
                                    Margin="0,5,0,0"/>

                            <RadioButton x:Name="CardCheck"
                                    Content="Оплата картой"
                                    GroupName="PaymentMethod"
                                    Margin="0,5,0,0"/>

                        </StackPanel>

                        <CheckBox x:Name="AgreementCheck"
                                  FontSize="12"
                                  Foreground="#374151"
                                  Margin="0,10,0,20"
                                  Content="Я соглашаюсь с условиями обработки персональных данных"/>

                        <Button Content="Забронировать"
                                Height="48"
                                Background="#1E3A8A"
                                Foreground="White"
                                FontSize="15"
                                Cursor="Hand"
                                Click="BookingButton_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
