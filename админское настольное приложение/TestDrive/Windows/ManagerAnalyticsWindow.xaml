<Window x:Class="TestDrive.Windows.ManagerAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Аналитика"
        WindowState="Maximized"
        Background="#F3F4F6"
        Icon="/Resources/logo.ico">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="15,20,15,0">

                    <TextBlock Text="Автосалон"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Панель менеджера"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel Grid.Row="1"
                            Margin="10,30,10,0">

                    <Button Height="40"
                            BorderThickness="0"
                            Background="White"
                            Cursor="Hand"
                            Click="CarsButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🚘"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Автомобили"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Margin="0,10,0,0"
                            BorderThickness="0"
                            Background="White"
                            Cursor="Hand"
                            Click="BookingsButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📅"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Бронирования"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Margin="0,10,0,0"
                            Background="#1E3A8A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📊"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Аналитика"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Margin="0,10,0,0"
                            BorderThickness="0"
                            Background="White"
                            Cursor="Hand"
                            Click="ProfileButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="👤"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Профиль"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="UserText"
                                   FontWeight="Bold"
                                   FontSize="15"/>

                        <TextBlock x:Name="EmailText"
                                   Foreground="#9CA3AF"
                                   FontSize="12"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="90"
                            Height="35"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Click="ExitButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="↪"
                                       Foreground="#6B7280"/>

                            <TextBlock Text="Выйти"
                                       Margin="5,0,0,0"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="25">

                    <TextBlock Text="Аналитика автосалона"
                               FontSize="34"
                               FontWeight="Bold"
                               Margin="0,0,0,30"/>

                    <UniformGrid Columns="5"
                                 Margin="0,0,0,35">

                        <Border Background="White"
                                CornerRadius="15"
                                Margin="8"
                                Padding="25">

                            <StackPanel>

                                <TextBlock Text="Автомобили"
                                           FontSize="16"
                                           Foreground="Gray"/>

                                <TextBlock x:Name="CarsCountText"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="15"
                                Margin="8"
                                Padding="25">

                            <StackPanel>

                                <TextBlock Text="Бронирования"
                                           FontSize="16"
                                           Foreground="Gray"/>

                                <TextBlock x:Name="BookingsCountText"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="15"
                                Margin="8"
                                Padding="25">

                            <StackPanel>

                                <TextBlock Text="Клиенты"
                                           FontSize="16"
                                           Foreground="Gray"/>

                                <TextBlock x:Name="ClientsCountText"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="15"
                                Margin="8"
                                Padding="25">

                            <StackPanel>

                                <TextBlock Text="Подтверждено"
                                           FontSize="16"
                                           Foreground="Gray"/>

                                <TextBlock x:Name="ConfirmedText"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border Background="White"
                                CornerRadius="15"
                                Margin="8"
                                Padding="25">

                            <StackPanel>

                                <TextBlock Text="Доход"
                                           FontSize="16"
                                           Foreground="Gray"/>

                                <TextBlock x:Name="RevenueText"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>

                    </UniformGrid>

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="550"/>
                            <RowDefinition Height="550"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- POPULAR CARS -->

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="White"
                                Margin="10"
                                CornerRadius="15"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Популярные автомобили"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <lvc:CartesianChart x:Name="CarsChart"
                                                    Height="420"
                                                    LegendLocation="Right"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="White"
                                Margin="10"
                                CornerRadius="15"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Статусы бронирований"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <lvc:PieChart x:Name="StatusChart"
                                              Height="420"
                                              LegendLocation="Right"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Background="White"
                                Margin="10"
                                CornerRadius="15"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Бронирования по дням"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <lvc:CartesianChart x:Name="BookingsChart"
                                                    Height="420"
                                                    LegendLocation="Right"/>

                            </StackPanel>

                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Background="White"
                                Margin="10"
                                CornerRadius="15"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Популярные бренды"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <lvc:CartesianChart x:Name="BrandsChart"
                                                    Height="420"
                                                    LegendLocation="Right"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
