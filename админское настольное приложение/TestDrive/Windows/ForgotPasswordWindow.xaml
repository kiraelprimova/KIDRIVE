<Window x:Class="TestDrive.Windows.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля"
        Height="650"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="/Resources/logo.ico">

    <ScrollViewer>

        <StackPanel Margin="35">

            <TextBlock Text="Восстановление пароля"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#FF3D3D3D"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Номер телефона"
                       FontSize="13"
                       Foreground="#666"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="PhoneBox"
                     Height="35"
                     FontSize="13"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#FFD0D0D0"
                     BorderThickness="1"
                     Margin="0,0,0,20"
                     TextChanged="PhoneBox_TextChanged"
                     MaxLength="18"/>

            <Button x:Name="SendCodeButton"
                    Content="Отправить код"
                    Height="42"
                    Background="#FF1E3A8A"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    Margin="0,0,0,20"
                    Click="SendCodeButton_Click"/>

            <StackPanel x:Name="CodePanel"
                        Visibility="Collapsed">

                <TextBlock Text="Введите код"
                           FontSize="13"
                           Foreground="#666"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="CodeBox"
                         Height="35"
                         FontSize="13"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#FFD0D0D0"
                         BorderThickness="1"
                         Margin="0,0,0,20"/>

                <Button Content="Подтвердить"
                        Height="42"
                        Background="#FF1E3A8A"
                        Foreground="White"
                        FontSize="14"
                        Cursor="Hand"
                        Margin="0,0,0,20"
                        Click="ConfirmCodeButton_Click">

                    <Button.Style>
                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">

                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Setter.Value>
                            </Setter>

                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>

            <StackPanel x:Name="PasswordPanel"
                        Visibility="Collapsed">

                <TextBlock Text="Новый пароль"
                           FontSize="13"
                           Foreground="#666"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,5">

                    <PasswordBox x:Name="Password"
                                 Height="35"
                                 FontSize="13"
                                 Padding="10,0,40,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#FFD0D0D0"
                                 BorderThickness="1"
                                 PasswordChanged="Password_PasswordChanged"/>

                    <TextBox x:Name="PasswordText"
                             Height="35"
                             FontSize="13"
                             Padding="10,0,40,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#FFD0D0D0"
                             BorderThickness="1"
                             Visibility="Collapsed"
                             TextChanged="PasswordText_TextChanged"/>

                    <CheckBox x:Name="ShowPassword"
                              Content="👁"
                              Width="40"
                              Height="20"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Checked="ShowPassword_Checked"
                              Unchecked="ShowPassword_Unchecked"/>

                </Grid>

                <TextBlock Text="Минимум 8 символов"
                           FontSize="11"
                           Foreground="#999"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Подтверждение пароля"
                           FontSize="13"
                           Foreground="#666"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,20">

                    <PasswordBox x:Name="ConfirmPassword"
                                 Height="35"
                                 FontSize="13"
                                 Padding="10,0,40,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#FFD0D0D0"
                                 BorderThickness="1"
                                 PasswordChanged="ConfirmPassword_PasswordChanged"/>

                    <TextBox x:Name="ConfirmPasswordText"
                             Height="35"
                             FontSize="13"
                             Padding="10,0,40,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#FFD0D0D0"
                             BorderThickness="1"
                             Visibility="Collapsed"
                             TextChanged="ConfirmPasswordText_TextChanged"/>

                    <CheckBox x:Name="ShowConfirmPassword"
                              Content="👁"
                              Width="40"
                              Height="20"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Checked="ShowConfirmPassword_Checked"
                              Unchecked="ShowConfirmPassword_Unchecked"/>

                </Grid>

                <Button Content="Изменить пароль"
                        Height="42"
                        Background="#FF1E3A8A"
                        Foreground="White"
                        FontSize="14"
                        Cursor="Hand"
                        Click="ChangePasswordButton_Click">

                    <Button.Style>
                        <Style TargetType="Button">

                            <Setter Property="Template">
                                <Setter.Value>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">

                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Setter.Value>
                            </Setter>

                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Window>