<Window x:Class="TestDrive.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="469"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="/Resources/logo.ico">

    <StackPanel Margin="35"
                Cursor="">

        <TextBlock Text="Авторизация"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#FF3D3D3D"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <TextBlock Text="Номер телефона"
                   FontSize="14"
                   Foreground="#666"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="PhoneNumber"
                 Height="38"
                 FontSize="14"
                 Padding="10,0"
                 VerticalContentAlignment="Center"
                 BorderBrush="#FFD0D0D0"
                 BorderThickness="1"
                 Margin="0,0,0,20"
                 TextChanged="PhoneNumber_TextChanged"
                 MaxLength="18"/>

        <TextBlock Text="Пароль"
                   FontSize="14"
                   Foreground="#666"
                   Margin="0,0,0,6"/>

        <Grid Margin="0,0,0,25">

            <PasswordBox x:Name="Password"
                         Height="38"
                         FontSize="14"
                         Padding="10,0,40,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#FFD0D0D0"
                         BorderThickness="1"
                         MaxLength="20"/>

            <TextBox x:Name="PasswordText"
                     Height="38"
                     FontSize="14"
                     Padding="10,0,40,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="#FFD0D0D0"
                     BorderThickness="1"
                     Visibility="Collapsed"/>

            <CheckBox x:Name="ShowPassword"
                      Content="👁"
                      Width="46"
                      Height="18"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Background="Transparent"
                      BorderThickness="0"
                      Checked="ShowPassword_Checked"
                      Unchecked="ShowPassword_Unchecked"/>

        </Grid>

        <Button x:Name="ForgotPasswordButton"
                Content="Забыли пароль?"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#FF028AB4"
                FontSize="12"
                Cursor="Hand"
                HorizontalAlignment="Right"
                Margin="0,0,0,15"
                Click="ForgotPasswordButton_Click">

            <Button.Style>
                <Style TargetType="Button">

                    <Setter Property="Template">
                        <Setter.Value>

                            <ControlTemplate TargetType="Button">

                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextDecorations="Underline"/>

                            </ControlTemplate>

                        </Setter.Value>
                    </Setter>

                </Style>
            </Button.Style>

        </Button>

        <StackPanel Orientation="Horizontal">

            <Button x:Name="LoginButton"
                    Content="Войти"
                    Width="150"
                    Height="42"
                    Background="#FF1E3A8A"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    Margin="0,0,0,18"
                    Click="LoginButton_Click">

                <Button.Style>
                    <Style TargetType="Button">

                        <Setter Property="Template">
                            <Setter.Value>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Setter.Value>
                        </Setter>

                    </Style>
                </Button.Style>

            </Button>

            <Button x:Name="GuestButton"
                    Content="Гость"
                    Width="135"
                    Height="42"
                    Background="#FF1E3A8A"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    Margin="10,0,0,18"
                    Click="GuestButton_Click">

                <Button.Style>
                    <Style TargetType="Button">

                        <Setter Property="Template">
                            <Setter.Value>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                    </Border>

                                </ControlTemplate>

                            </Setter.Value>
                        </Setter>

                    </Style>
                </Button.Style>

            </Button>

        </StackPanel>

        <Button x:Name="RegisterBT"
                Content="Нет аккаунта? Регистрация"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#FF028AB4"
                FontSize="12"
                Cursor="Hand"
                HorizontalAlignment="Center"
                Padding="0"
                Click="RegisterBT_Click">

            <Button.Style>
                <Style TargetType="Button">

                    <Setter Property="Template">
                        <Setter.Value>

                            <ControlTemplate TargetType="Button">

                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextDecorations="Underline"/>

                            </ControlTemplate>

                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter Property="Foreground"
                                    Value="#FF4F2826"/>

                        </Trigger>

                    </Style.Triggers>

                </Style>
            </Button.Style>

        </Button>

    </StackPanel>

</Window>