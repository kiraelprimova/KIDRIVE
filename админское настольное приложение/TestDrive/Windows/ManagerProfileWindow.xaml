<Window x:Class="TestDrive.Windows.ManagerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль"
        WindowState="Maximized"
        Background="#F5F5F5"
        Icon="/Resources/logo.ico">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,20,10,0">

                    <TextBlock Text="Автосалон"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Панель менеджера"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="8,25,8,0">

                    <Button Height="34"
                            Margin="0,0,0,12"
                            Click="CarsButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border CornerRadius="8"
                                        Background="{TemplateBinding Background}">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="🚘"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Автомобили"
                                   FontSize="13"
                                   Foreground="#111827"/>

                    </Button>

                    <Button Height="34"
                            Margin="0,0,0,12"
                            Click="BookingsButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border CornerRadius="8"
                                        Background="{TemplateBinding Background}">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="📅"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Бронирования"
                                   FontSize="13"
                                   Foreground="#111827"/>

                    </Button>

                    <Button Height="40"
        Margin="0,10,0,0"
        BorderThickness="0"
        Background="White"
        Cursor="Hand"
        Click="AnalyticsButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📊"
                   Margin="10,0,10,0"/>

                            <TextBlock Text="Аналитика"/>

                        </StackPanel>

                    </Button>

                    <Button Height="34"
                            Margin="0,0,0,12"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border CornerRadius="8"
                                        Background="{TemplateBinding Background}">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="👤"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Профиль"
                                   FontSize="13"/>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="UserText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="EmailText"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="90"
                            Height="30"
                            Click="ExitButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="↪"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="Выйти"
                                       FontSize="13"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1">

                <Grid Margin="40">

                    <Border Background="White"
                            CornerRadius="15"
                            Padding="40">

                        <StackPanel Height="580"
                                    VerticalAlignment="Bottom">

                            <DockPanel Margin="0,0,0,20">

                                <TextBlock Text="Профиль менеджера"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           DockPanel.Dock="Left"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <Button x:Name="EditButton"
                                            Width="160"
                                            Height="40"
                                            Margin="0,0,15,0"
                                            Background="#1E3A8A"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="EditButton_Click">

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="10">

                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>
                                        </Button.Template>

                                        <TextBlock x:Name="EditButtonText"
                                                   Text="Редактировать"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>

                                    </Button>

                                    <Button x:Name="CancelButton"
                                            Width="160"
                                            Height="40"
                                            Margin="0,0,15,0"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            Click="CancelButton_Click">

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="10">

                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>
                                        </Button.Template>

                                        <TextBlock Text="Отменить"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>

                                    </Button>

                                    <Button Width="160"
                                            Height="40"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="DeleteButton_Click">

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">

                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="10">

                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>

                                                </Border>

                                            </ControlTemplate>
                                        </Button.Template>

                                        <TextBlock Text="Удалить аккаунт"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>

                                    </Button>

                                </StackPanel>

                            </DockPanel>

                            <TextBlock Text="Имя"/>

                            <TextBox x:Name="FirstNameBox"
                                     Height="36"
                                     Margin="0,3,0,10"
                                     IsEnabled="False"
                                     TextChanged="Capitalize_TextChanged"
                                     MaxLength="10"/>

                            <TextBlock Text="Фамилия"/>

                            <TextBox x:Name="LastNameBox"
                                     Height="36"
                                     Margin="0,3,0,10"
                                     IsEnabled="False"
                                     TextChanged="Capitalize_TextChanged"
                                     MaxLength="15"/>

                            <TextBlock Text="Отчество"/>

                            <TextBox x:Name="PatronymicBox"
                                     Height="36"
                                     Margin="0,3,0,10"
                                     IsEnabled="False"
                                     TextChanged="Capitalize_TextChanged"
                                     MaxLength="15"/>

                            <TextBlock Text="Телефон"/>

                            <TextBox x:Name="PhoneBox"
                                     Height="36"
                                     Margin="0,3,0,10"
                                     IsEnabled="False"
                                     TextChanged="PhoneBox_TextChanged"
                                     MaxLength="18"/>

                            <TextBlock Text="Почта"/>

                            <TextBox x:Name="EmailBox"
                                     Height="36"
                                     Margin="0,3,0,10"
                                     IsEnabled="False"
                                     TextChanged="Email_TextChanged"
                                     MaxLength="30"/>

                            <TextBlock Text="Пароль"/>

                            <Grid Margin="0,3,0,10">

                                <PasswordBox x:Name="PasswordBox"
                                             Height="36"
                                             Padding="10,0,40,0"
                                             MaxLength="20"
                                             IsEnabled="False"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>

                                <TextBox x:Name="PasswordTextBox"
                                         Height="36"
                                         Padding="10,0,40,0"
                                         MaxLength="20"
                                         Visibility="Collapsed"
                                         IsEnabled="False"
                                         TextChanged="PasswordTextBox_TextChanged"/>

                                <CheckBox x:Name="ShowPasswordBox"
                                          Content="👁"
                                          Width="40"
                                          Height="20"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Checked="ShowPasswordBox_Checked"
                                          Unchecked="ShowPasswordBox_Unchecked"/>

                            </Grid>

                            <TextBlock Text="Повторите пароль"/>

                            <Grid Margin="0,3,0,10">

                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Height="36"
                                             Padding="10,0,40,0"
                                             MaxLength="20"
                                             IsEnabled="False"
                                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                                <TextBox x:Name="ConfirmPasswordTextBox"
                                         Height="36"
                                         Padding="10,0,40,0"
                                         MaxLength="20"
                                         Visibility="Collapsed"
                                         IsEnabled="False"
                                         TextChanged="ConfirmPasswordTextBox_TextChanged"/>

                                <CheckBox x:Name="ShowConfirmPasswordBox"
                                          Content="👁"
                                          Width="40"
                                          Height="20"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Checked="ShowConfirmPasswordBox_Checked"
                                          Unchecked="ShowConfirmPasswordBox_Unchecked"/>

                            </Grid>

                            <TextBlock Text="Дата рождения"/>

                            <DatePicker x:Name="BirthDateBox"
                                        Height="36"
                                        Margin="0,3,0,10"
                                        IsEnabled="False"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>