<Window x:Class="TestDrive.Windows.ManagerBookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирования"
        WindowState="Maximized"
        Background="#F3F4F6"
        Icon="/Resources/logo.ico">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="15,20,15,0">

                    <TextBlock Text="Автосалон"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Панель менеджера"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="10,30,10,0">

                    <Button Height="40"
                            BorderThickness="0"
                            Background="White"
                            Cursor="Hand"
                            Click="CarsButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🚘"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Автомобили"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Margin="0,10,0,0"
                            Background="#1E3A8A"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📅"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Бронирования"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
        Margin="0,10,0,0"
        BorderThickness="0"
        Background="White"
        Cursor="Hand"
        Click="AnalyticsButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📊"
                   Margin="10,0,10,0"/>

                            <TextBlock Text="Аналитика"/>

                        </StackPanel>

                    </Button>

                    <Button Height="40"
                            Margin="0,10,0,0"
                            BorderThickness="0"
                            Background="White"
                            Cursor="Hand"
                            Click="ProfileButton_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="👤"
                                       Margin="10,0,10,0"/>

                            <TextBlock Text="Профиль"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <ScrollViewer Grid.Column="1">

            <StackPanel Margin="20">

                <TextBlock Text="Бронирования"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,25"/>

                <ComboBox x:Name="StatusFilterBox"
                          Width="220"
                          Height="38"
                          Margin="0,0,0,20"
                          SelectionChanged="StatusFilterBox_SelectionChanged">

                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="В рассмотрении"/>
                    <ComboBoxItem Content="Подтверждено"/>
                    <ComboBoxItem Content="Отменено"/>

                </ComboBox>

                <StackPanel x:Name="BookingsPanel"
                            HorizontalAlignment="Stretch"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>