<Window x:Class="TestDrive.Windows.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог автомобилей"
        WindowState="Maximized"
        Background="#F5F5F5"
        ResizeMode="CanMinimize"
        Width="591"
        Icon="/Resources/logo.ico">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,20,10,0">

                    <TextBlock Text="Автосалон"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>

                    <TextBlock Text="Тест-драйв"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="8,25,8,0">

                    <Button x:Name="CatalogButton"
                            Height="34"
                            Margin="0,0,0,12"
                            Click="CatalogButton_Click"
                            Background="#1E3A8A"
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="🚘"
                                                   FontSize="14"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Каталог автомобилей"
                                   FontSize="13"/>

                    </Button>

                    <Button x:Name="BookingsButton"
                            Height="34"
                            Margin="0,0,0,12"
                            Click="BookingsButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="📅"
                                                   FontSize="13"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Мои бронирования"
                                   FontSize="13"
                                   Foreground="#111827"/>

                    </Button>

                    <Button x:Name="ProfileButton"
                            Height="34"
                            Click="ProfileButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="👤"
                                                   FontSize="13"
                                                   Margin="12,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <ContentPresenter VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Профиль"
                                   FontSize="13"
                                   Foreground="#111827"/>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="UserNameText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="UserEmailText"
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="90"
                            Height="30"
                            Click="ExitButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="↪"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="Выйти"
                                       FontSize="13"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="20">

                    <TextBlock Text="Каталог автомобилей"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <Border Background="#F9FAFB"
                                    BorderBrush="#1E3A8A"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Height="46">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🔍"
                                               FontSize="14"
                                               Foreground="#1E3A8A"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <TextBox x:Name="SearchBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             Foreground="#111827"
                                             VerticalContentAlignment="Center"
                                             TextChanged="SearchBox_TextChanged"/>

                                </Grid>

                            </Border>

                            <Grid Margin="0,15,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Марка"
                                               FontSize="12"
                                               Margin="2,0,0,6"/>

                                    <ComboBox x:Name="BrandBox"
                                              Height="27"
                                              Background="#F3F4F6"
                                              BorderBrush="#E5E7EB"
                                              SelectionChanged="BrandBox_SelectionChanged"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="Год выпуска"
                                               FontSize="12"
                                               Margin="2,0,0,6"/>

                                    <ComboBox x:Name="YearBox"
                                              Height="27"
                                              Background="#F3F4F6"
                                              BorderBrush="#E5E7EB"
                                              SelectionChanged="YearBox_SelectionChanged"/>

                                </StackPanel>

                                <StackPanel Grid.Column="4">

                                    <TextBlock Text="Сортировка"
                                               FontSize="12"
                                               Margin="2,0,0,6"/>

                                    <ComboBox x:Name="SortBox"
                                              Height="27"
                                              SelectionChanged="SortBox_SelectionChanged"
                                              Background="#F3F4F6"
                                              BorderBrush="#E5E7EB">

                                        <ComboBoxItem Content="Все"/>
                                        <ComboBoxItem Content="А-Я"/>
                                        <ComboBoxItem Content="Я-А"/>

                                    </ComboBox>

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <WrapPanel x:Name="CarsPanel"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <TextBlock x:Name="EmptyText"
                               Text="Здесь пока ничего нет"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,60,0,0"
                               Visibility="Collapsed"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>