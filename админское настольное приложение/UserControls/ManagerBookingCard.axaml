<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TestDriveAvalonia.UserControls.ManagerBookingCard"
             Height="170"
             HorizontalAlignment="Stretch">

    <Border Background="White"
            CornerRadius="15"
            Margin="0,0,0,15"
            Padding="20"
            BoxShadow="0 3 15 0 #26000000">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ClientText"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock x:Name="CarText"
                           FontSize="15"
                           Margin="0,10,0,0"
                           Foreground="#374151"/>

                <TextBlock x:Name="DateText"
                           FontSize="14"
                           Margin="0,6,0,0"
                           Foreground="#6B7280"/>
            </StackPanel>

            <!-- Правая часть -->
            <Border Grid.Column="1"
                    Background="#F9FAFB"
                    CornerRadius="12"
                    Padding="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Right">
                    <!-- Статус -->
                    <Border x:Name="StatusBorder"
                            Height="30"
                            Padding="12,0"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10">

                        <TextBlock x:Name="StatusText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Кнопки -->
                    <StackPanel x:Name="ButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Width="100"
                                Height="36"
                                Background="#16A34A"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="8"
                                Cursor="Hand"
                                Margin="0,0,8,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="ApproveButton_Click">
                            <TextBlock Text="Принять" FontWeight="SemiBold"/>
                        </Button>

                        <Button Width="100"
                                Height="36"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="8"
                                Cursor="Hand"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="RejectButton_Click">
                            <TextBlock Text="Отклонить" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
